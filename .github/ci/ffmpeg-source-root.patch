diff --git a/contrib/src/ffmpeg/windows-configure-make.sh b/contrib/src/ffmpeg/windows-configure-make.sh
--- a/contrib/src/ffmpeg/windows-configure-make.sh
+++ b/contrib/src/ffmpeg/windows-configure-make.sh
@@ -4,5 +4,20 @@
 DIR=$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )
 cd $DIR/../../build/ffmpeg
+# The Windows archive extractor can leave the FFmpeg source below a single
+# top-level directory. Normalize that layout before configure computes the
+# source path used by the generated Makefile.
+if [ ! -f Makefile ]; then
+    nested_root=$(find . -mindepth 1 -maxdepth 1 -type d -name 'ffmpeg-*' -print -quit)
+    if [ -n "$nested_root" ] && [ -f "$nested_root/Makefile" ]; then
+        echo "Normalizing FFmpeg source root from $nested_root"
+        find "$nested_root" -mindepth 1 -maxdepth 1 -exec mv -f -- {} . \;
+        rmdir "$nested_root"
+    fi
+fi
+if [ ! -f Makefile ]; then
+    echo "FFmpeg source Makefile missing under $(pwd)" >&2
+    exit 1
+fi
 FFMPEGCONF='
             --toolchain=msvc
             --target-os=win32'
diff --git a/contrib/src/ffmpeg/build_ffmpeg.bat b/contrib/src/ffmpeg/build_ffmpeg.bat
--- a/contrib/src/ffmpeg/build_ffmpeg.bat
+++ b/contrib/src/ffmpeg/build_ffmpeg.bat
@@ -1,3 +1,18 @@
 set MSYS2_PATH_TYPE=inherit
+set "FFMPEG_BUILD_DIR=%~dp0..\..\build\ffmpeg"
+if not exist "%FFMPEG_BUILD_DIR%\Makefile" (
+    for /d %%D in ("%FFMPEG_BUILD_DIR%\ffmpeg-*") do (
+        if exist "%%D\Makefile" (
+            echo Normalizing FFmpeg source root from %%D
+            robocopy "%%D" "%FFMPEG_BUILD_DIR%" /E /MOVE /R:1 /W:1 /NFL /NDL /NJH /NJS /NC /NS /NP
+            if errorlevel 8 exit /b 1
+            rmdir /s /q "%%D"
+        )
+    )
+)
+if not exist "%FFMPEG_BUILD_DIR%\Makefile" (
+    echo FFmpeg source Makefile missing under %FFMPEG_BUILD_DIR% 1>&2
+    exit /b 1
+)
 IF exist C:\msys64\usr\bin ( set MSYS2_BIN="C:\msys64\usr\bin\bash.exe" ) ELSE ( set MSYS2_BIN="C:\tools\msys64\usr\bin\bash.exe" )
 %MSYS2_BIN% --login -x %CONTRIB_SRC_DIR%\ffmpeg\windows-configure-make.sh win32 x64
diff --git a/contrib/src/ffmpeg/windows-configure-make.sh b/contrib/src/ffmpeg/windows-configure-make.sh
--- a/contrib/src/ffmpeg/windows-configure-make.sh
+++ b/contrib/src/ffmpeg/windows-configure-make.sh
@@ -213,5 +213,96 @@
 set -x
 set -e
+# Keep the main FFmpeg Makefile beside the generated build Makefile. The
+# generated include otherwise points at the source tree with an absolute
+# MSYS path, which can become invalid after extraction/patching on Windows.
+cp -f ../../../Makefile ffmpeg-main-makefile
 ../../../configure $FFMPEGCONF --extra-cflags="${EXTRACFLAGS}" --extra-ldflags="${EXTRALDFLAGS}" --prefix="${PREFIX}" --extra-cxxflags="-std:c++20 /Zc:__cplusplus"
+if [ ! -f ../../../ar-lib ]; then
+    wget -q -O ../../../ar-lib https://raw.githubusercontent.com/autotools-mirror/automake/v1.16.5/lib/ar-lib
+    chmod +x ../../../ar-lib
+fi
+if ! grep -q 'JAMI_CI_ABSOLUTE_MEMBER_PATHS' ../../../ar-lib; then
+    sed -i '/^  file=$1$/a\
+  # JAMI_CI_ABSOLUTE_MEMBER_PATHS\
+  case $file in\
+    /*) ;;\
+    *) file="$PWD/$file" ;;\
+  esac\
+  case $file in\
+    *.o)\
+      if test ! -f "$file" && test -f "${file%.o}.obj"; then\
+        echo "Using MSVC object fallback: $file -> ${file%.o}.obj" >&2\
+        file="${file%.o}.obj"\
+      fi\
+      ;;\
+  esac' ../../../ar-lib
+fi
+if ! sed -i 's/^LIBSUF=.a$/LIBSUF=.lib/' ffbuild/config.mak || ! grep -q '^LIBSUF=.lib$' ffbuild/config.mak; then
+    echo "Unable to normalize FFmpeg static library suffix" >&2
+    exit 1
+fi
+if [ ! -x ../../../jami-lib-wrapper.sh ]; then
+    {
+        printf '%s\n' '#!/usr/bin/env bash'
+        printf '%s\n' 'set -e'
+        printf '%s\n' 'lib_exe=$(command -v lib.exe || true)'
+        printf '%s\n' 'if [ -z "$lib_exe" ]; then'
+        printf '%s\n' '    echo "MSVC lib.exe is not on PATH" >&2'
+        printf '%s\n' '    exit 1'
+        printf '%s\n' 'fi'
+        printf '%s\n' 'response_file=$(mktemp "${TMPDIR:-/tmp}/jami-lib.XXXXXX")'
+        printf '%s\n' 'cleanup() { rm -f "$response_file"; }'
+        printf '%s\n' 'trap cleanup EXIT'
+        printf '%s\n' 'for argument in "$@"; do'
+        printf '%s\n' '    printf "\042%s\042\n" "$argument" >> "$response_file"'
+        printf '%s\n' 'done'
+        printf '%s\n' 'response_file_win=$(cygpath -w "$response_file")'
+        printf '%s\n' '"$lib_exe" "@$response_file_win"'
+    } > ../../../jami-lib-wrapper.sh
+    chmod +x ../../../jami-lib-wrapper.sh
+fi
+{
+    printf 'override SRC_PATH := ../../../\n'
+    printf 'override SRC_LINK := ../../../\n'
+    printf '%s\n' 'override CC_O = -Fo$@'
+    printf '%s\n' 'override CXX_O = -Fo$@'
+    printf '%s\n' 'override OBJCC_O = -Fo$@'
+    # FFmpeg invokes lib.exe through the MSYS2 shell. The wrapper moves the
+    # long member list into a LIB response file before invoking lib.exe.
+    printf '%s\n' 'override AR := ../../../ar-lib ../../../jami-lib-wrapper.sh'
+    printf '%s\n' 'override ARFLAGS := rc'
+    printf '%s\n' 'override AR_O = $@'
+    # The FFmpeg MSVC dependency scanner is only needed for incremental builds.
+    # Its path conversion is broken in the MSYS2/PowerShell environment and can
+    # corrupt later lib.exe invocations, so omit dependency sidecar generation
+    # for this clean CI build.
+    printf '%s\n' 'override CCDEP ='
+    printf '%s\n' 'override CXXDEP ='
+    printf 'include ffmpeg-main-makefile\n'
+} > Makefile
+if [ ! -f ../../../tools/Makefile ]; then
+    echo "FFmpeg tools Makefile disappeared during configure; restoring tools from the source archive"
+    archive=$(find "$DIR/../../tarballs" -maxdepth 1 -type f -name 'ffmpeg_*.tar.xz' -print -quit)
+    if [ -z "$archive" ]; then
+        echo "FFmpeg source archive not found under $DIR/../../tarballs" >&2
+        exit 1
+    fi
+    tar -xJf "$archive" --strip-components=1 -C ../../../ "ffmpeg-6.0.1/tools"
+fi
+if [ ! -f ../../../tools/Makefile ]; then
+    echo "FFmpeg tools Makefile is unavailable after configure" >&2
+    exit 1
+fi
+make V=1 -j8 libavdevice/alldevices.o
+if [ ! -f libavdevice/alldevices.o ]; then
+    if [ -f libavdevice/alldevices.obj ]; then
+        echo "Renaming MSVC object libavdevice/alldevices.obj to .o"
+        mv -f libavdevice/alldevices.obj libavdevice/alldevices.o
+    else
+        echo "FFmpeg did not produce libavdevice/alldevices.o or .obj" >&2
+        find . -type f -iname 'alldevices.*' -print >&2
+        exit 1
+    fi
+fi
 make -j8 install
 cd ../../..
